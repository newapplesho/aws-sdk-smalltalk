SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'AWS',
      #directory : 'src',
      #load : [ 'CI' ],
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #include : {
      #classes : [
        #SignatureV4Test,
        #AWSClientTest,
        #AWSS3ConfigTest,
        #AWSS3RequestTest,
        #AWSLambdaConfigTest,
        #AWSLambdaRequestTest,
        #DynamoDBListTablesTest,
        #DynamoDBMapperTest,
        #DynamoDBRawClientRequestTest
      ]
    },
    #exclude : {
      #packages : [ 'AWS.*' ]
    }
  }
}